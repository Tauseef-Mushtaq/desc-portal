# Copy this file to .env and fill in your values

PORT=5000

# Option 1: Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/desc_portal

# Option 2: MongoDB Atlas (cloud — replace with your connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/desc_portal?retryWrites=true&w=majority

# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if this is left unchanged.
JWT_SECRET=REPLACE_THIS_WITH_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRE=7d
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Redis — backs the Socket.IO adapter so real-time notifications fan out
# correctly across all backend replicas (see backend/utils/socket.js).
# Local dev / docker-compose:
REDIS_URL=redis://localhost:6379
# Docker Compose service name instead, if running backend itself in a container:
# REDIS_URL=redis://redis:6379

# Object storage (S3-compatible) — request attachments and avatars live here
# instead of local disk, since local disk doesn't survive across backend
# replicas. Local dev / docker-compose points this at MinIO; leaving
# S3_ENDPOINT unset in production makes the SDK talk to real AWS S3 instead,
# with credentials resolved from the cluster's IAM role.
S3_BUCKET=desc-portal-uploads
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
# Only needed when S3_ENDPOINT is an internal-only hostname unreachable by a
# browser (e.g. "http://minio:9000" in docker-compose/k8s). Leave it equal to
# S3_ENDPOINT here for plain local dev where everything's on localhost — set
# it differently only once backend and browser stop sharing the same host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
# In production against real AWS S3, comment out S3_ENDPOINT, S3_FORCE_PATH_STYLE,
# and the two key/secret lines above — the SDK will use the pod/instance IAM role.
